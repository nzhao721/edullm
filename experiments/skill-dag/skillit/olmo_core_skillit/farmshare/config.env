# Skill-It 370M FarmShare profile (source from submit_from_laptop.sh).
# Runs non-production at 4 data-parallel ranks (per-user FarmShare GPU cap);
# launch.sh always passes --allow-local-only for this reason. See SKILLIT.md.
EXPERIMENT_SLUG="skillit-370m"
INPUT_FAMILY="skillit"
STAGE_ROOT_REL="inputs/skillit"
DATASET_ID="pretrain/olmo-127b"
DATASET_VERSION="v1"
EVAL_REQUIREMENTS="requirements-skillit-eval.txt"
STAGE_EXTRA_ARGS=()
TRAIN_GPUS="${TRAIN_GPUS:-4}"
TRAIN_CPUS="${TRAIN_CPUS:-32}"
TRAIN_MEM="${TRAIN_MEM:-192G}"
TRAIN_TIME="${TRAIN_TIME:-20:00:00}"
STAGE_GPUS="${STAGE_GPUS:-1}"
STAGE_CPUS="${STAGE_CPUS:-8}"
STAGE_MEM="${STAGE_MEM:-32G}"
STAGE_TIME="${STAGE_TIME:-06:00:00}"
